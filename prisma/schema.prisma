generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                  @id @default(cuid())
  name                  String?
  email                 String?                 @unique
  emailVerified         DateTime?
  image                 String?
  credits               Int                     @default(10)
  accounts              Account[]
  sessions              Session[]
  AmazonProductCreation AmazonProductCreation[]
  projects              Project[]
  providerProfiles      ProviderProfile[]
  modelRoleAssignments  ModelRoleAssignment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AmazonProductCreation {
  id          String   @id @default(cuid())
  userId      String
  inputUrls   String   @db.Text
  outputUrl   String?  @db.Text
  prompt      String   @db.Text
  aspectRatio String?
  status      String   @default("processing")
  requestId   String?  @unique
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id              String           @id @default(cuid())
  userId          String
  name            String
  productName     String?
  platform        String           @default("通用电商")
  aspectRatio     String           @default("1:1")
  notes           String?          @db.Text
  status          String           @default("draft")
  coverImageUrl   String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceImages ReferenceImage[]
  productIdentity ProductIdentity?
  analysisRuns    ProductAnalysisRun[]

  @@index([userId])
}

model ReferenceImage {
  id          String   @id @default(cuid())
  projectId   String
  url         String   @db.Text
  localPath   String?  @db.Text
  storageKey  String?
  fileName    String
  mimeType    String
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  includeInAnalysis Boolean @default(true)
  imageRole   String   @default("other")
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProductIdentity {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  productName                 String?
  category                    String?
  color                       String?
  material                    String?
  structure                   String?  @db.Text
  visibleFunctionsJson        String   @db.Text
  sellingPointsJson           String   @db.Text
  targetUsersJson             String   @db.Text
  usageScenariosJson          String   @db.Text
  mustKeepJson                String   @db.Text
  avoidChangesJson            String   @db.Text
  primaryReferenceDescription String?  @db.Text
  sourceProvider              String?
  sourceModel                 String?
  sourceProfileId             String?
  inputFingerprint            String?
  isStale                     Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  project                     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProductAnalysisRun {
  id                String    @id @default(cuid())
  projectId         String
  providerProfileId String?
  provider          String?
  model             String?
  inputFingerprint  String?
  status            String    @default("processing")
  errorCode         String?
  errorMessage      String?   @db.Text
  durationMs        Int?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([providerProfileId])
}

model ProviderProfile {
  id                       String                @id @default(cuid())
  userId                   String
  name                     String
  provider                 String
  baseUrl                  String?
  encryptedApiKey          String?               @db.Text
  apiKeyIv                 String?
  apiKeyAuthTag            String?
  apiKeyLast4              String?
  modelId                  String
  protocol                 String                @default("openai-compatible")
  capabilitiesJson         String                @db.Text
  timeoutMs                Int                   @default(30000)
  maxRetries               Int                   @default(0)
  enabled                  Boolean               @default(true)
  lastTestOk               Boolean?
  lastTestMessage          String?               @db.Text
  lastTestedAt             DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  User                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelRoleAssignments     ModelRoleAssignment[]

  @@index([userId])
}

model ModelRoleAssignment {
  id                String          @id @default(cuid())
  userId            String
  role              String
  providerProfileId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([providerProfileId])
}
